{% extends '@CitadelAureum/core/base.html.twig' %}
{% block title %}Compliance - {{ sop.title }} - Aureum{% endblock %}
{% block body %}
    <div class="card">
        <div class="card-title luxury items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="icon ph ph-list-checks"></i>
                Compliance - {{ sop.title }}
            </div>
            <form method="get" action="{{ path('aureum_sops_view', { id: sop.id }) }}">
                <button type="submit" class="luxury-light square btn btn-primary">
                    <i class="ph ph-arrow-left"></i> Back to SOP
                </button>
            </form>
        </div>
        <div class="card-body">
            <p class="sop-doc__meta">
                Version {{ sop.version }} &middot; {{ sop.status.label }}
                &middot; <span class="sop-chip sop-chip--current">{{ counts['current'] }} current</span>
                <span class="sop-chip sop-chip--sign">{{ counts['sign_off_needed'] }} awaiting sign-off</span>
                <span class="sop-chip sop-chip--recheck">{{ counts['recheck_due'] }} recheck due</span>
            </p>

            <table class="table w-100">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Standing</th>
                        <th>Signed version</th>
                        <th>Signed at</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.employee.name }}</td>
                            <td>
                                {% if row.standing.value == 'current' %}
                                    <span class="sop-chip sop-chip--current">Current</span>
                                {% elseif row.standing.value == 'recheck_due' %}
                                    <span class="sop-chip sop-chip--recheck">Recheck due</span>
                                {% else %}
                                    <span class="sop-chip sop-chip--sign">Awaiting sign-off</span>
                                {% endif %}
                            </td>
                            <td>{{ row.signOff ? 'v' ~ row.signOff.version : '-' }}</td>
                            <td>{{ row.signOff ? row.signOff.signedAt|date('j M Y H:i') : '-' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">No employees are in this SOP's audience.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if history is not empty %}
                <p class="mock-label mt-4" style="text-transform: uppercase; font-size: 0.72rem; letter-spacing: 0.1em; color: var(--au-muted);">Full sign-off history</p>
                <table class="table w-100">
                    <thead>
                        <tr><th>Employee</th><th>Version</th><th>Signed at</th></tr>
                    </thead>
                    <tbody>
                        {% for signOff in history %}
                            <tr>
                                <td>{{ signOff.employee.name }}</td>
                                <td>v{{ signOff.version }}</td>
                                <td>{{ signOff.signedAt|date('j M Y H:i') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
{% endblock %}
