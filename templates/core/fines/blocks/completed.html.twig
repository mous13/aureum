<div class="card-title" style="background-color:#13233A;color:#ececec;">
    Completed Fines
</div>
<div class="card-body">
    <table class="au-table-cards">
        <thead>
            <tr>
                <th class="text-left">Date</th>
                <th class="text-left">Fine Number</th>
                <th class="text-left">Guest Name</th>
                <th class="text-left">Guest Email</th>
                <th class="text-left">Logged By</th>
                <th class="text-left">Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for fine in fines %}
                {% if fine.status.value == 'appeal_completed'  %}
                    <tr>
                        <td data-label="Date">{{ fine.updatedAt|date('d/m/y H:i') }}</td>
                        <td data-label="Fine Number">{{ fine.number }}</td>
                        <td data-label="Guest Name">{{ fine.name }}</td>
                        <td data-label="Guest Email">{{ fine.email }}</td>
                        <td data-label="Logged By">{{ fine.createdBy.name }}</td>
                        <td data-label="Status">{{ fine.status.label }}</td>
                        <td>
                            {% include '@CitadelAureum/core/fines/blocks/fine_notes.html.twig' with {
                                'fine': fine,
                                'logs': logs[fine.id] ?? []
                            } %}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>