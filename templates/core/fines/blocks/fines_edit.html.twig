{% embed '@Forumify/components/modal.html.twig' %}
    {% block modalOpenButton %}
        <button type="button" class="btn-link" {{ stimulus_action('forumify/forumify-platform/modal', 'open') }}>
            <i class="ph ph-pencil-simple-line" style="color:#1a3f5f;"></i>
        </button>
    {% endblock %}
    {% block modalContent %}
        <div class="card">
            <div class="card-title luxury">Edit Fine - {{ fine.name }}: {{ fine.number }}</div>
            <div class="card-body">
                {{ form_start(editForm) }}
                <div class="form-field-grid">
                    {{ form_row(editForm.number) }}
                    {{ form_row(editForm.name) }}
                    {{ form_row(editForm.email) }}
                    {{ form_row(editForm.status) }}
                </div>
                <div class="form-section">
                    {{ form_row(editForm.note) }}
                </div>
                <div class="flex gap-2 mt-5">
                    <button type="submit" class="luxury-light square btn btn-primary">
                        Save Changes
                    </button>
                </div>
                {{ form_end(editForm) }}
            </div>
        </div>

    {% endblock %}
{% endembed %}