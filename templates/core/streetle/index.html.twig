{% extends '@CitadelAureum/core/base.html.twig' %}
{% block title %}Streetle - Aureum{% endblock %}
{% block body %}
    {{ component('Aureum\\Announcements', { module: 'streetle' }) }}
    {% set canManage = is_granted('aureum.module.streetle.manage') %}

    <div class="card">
        <div class="card-title luxury items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="icon ph ph-map-trifold"></i>
                Streetle
            </div>
            {% if canManage %}
                <form method="post" action="{{ path('aureum_streetle_refresh_map') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('Citadel\\Aureum\\Core\\Controller\\StreetleController::CSRF_TOKEN_ID')) }}">
                    <button type="submit" class="luxury-light square btn btn-primary"
                            title="{{ map ? 'Downloaded ' ~ map.importedAt|date('j M Y') : 'Download the streets from OpenStreetMap' }}">
                        <i class="ph ph-cloud-arrow-down"></i> {{ map ? 'Refresh map' : 'Download map' }}
                    </button>
                </form>
            {% endif %}
        </div>
        <div class="card-body">
            {% if map is null %}
                <div class="streetle-empty">
                    <i class="ph ph-map-trifold"></i>
                    <p>Streetle isn't ready yet.</p>
                    <p class="streetle-muted">
                        {% if canManage %}
                            Download the map to get started. It takes up to a minute.
                        {% else %}
                            Ask a manager to download the map.
                        {% endif %}
                    </p>
                </div>
            {% else %}
                <p class="streetle-intro">
                    Learn the {{ map.streetCount }} streets around the hotel. Click a street on the map and type its name.
                </p>
                <div class="streetle-modes">
                    {% for item in modes %}
                        <div class="streetle-mode">
                            <div>
                                <h3 class="streetle-mode__title">{{ item.mode.label }}</h3>
                                <p class="streetle-muted">
                                    {% if item.mode.value == 'sprint' %}
                                        Five minutes on the clock. Name as many streets as you can.
                                    {% else %}
                                        No clock. Work through the map at your own pace and finish when you're ready.
                                    {% endif %}
                                </p>
                                {% if item.best %}
                                    {% set best = item.best.session.correctCount %}
                                    <p class="streetle-mode__best">
                                        Your best: <strong>{{ best }} street{{ best == 1 ? '' : 's' }}</strong>
                                    </p>
                                {% endif %}
                            </div>
                            {% include '@CitadelAureum/core/streetle/blocks/start_form.html.twig' with {
                                mode: item.mode, label: 'Start ' ~ item.mode.label|lower,
                            } only %}
                        </div>
                    {% endfor %}
                </div>
                {% embed '@Forumify/components/tabs.html.twig' %}
                    {% block tabs %}
                        {% for item in periods %}
                            <button type="button" class="luxury-light square btn-link" data-tab-id="streetle-{{ item.period.value }}">{{ item.period.label }}</button>
                        {% endfor %}
                    {% endblock %}
                    {% block tabpanels %}
                        {% for item in periods %}
                            <div id="streetle-{{ item.period.value }}">
                                <div class="streetle-boards">
                                    {% for board in item.boards %}
                                        <div>
                                            {% include '@CitadelAureum/core/streetle/blocks/leaderboard.html.twig' with board|merge({
                                                period: item.period, employeeId: employee.id,
                                            }) only %}
                                            {% include '@CitadelAureum/core/streetle/blocks/rival.html.twig' with board|merge({ period: item.period }) only %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    {% endblock %}
                {% endembed %}
            {% endif %}
        </div>
    </div>
{% endblock %}
