{% extends '@CitadelAureum/core/base.html.twig' %}
{% set transSingle = (translationPrefix ~ 'single')|trans %}
{% block title_page %}
    Delete {{ transSingle|title }}
{% endblock %}
{% block body %}
    <div class="card">
        <div class="card-title luxury flex items-center gap-2">
            <i class="ph ph-warning"></i> {{ 'warning'|trans }}
        </div>
        <div class="card-body">
            <div class="alert-warning mb-4">
                <p class="mb-2">{{ 'admin.crud.delete_warning'|trans({ single: transSingle|lower }) }}</p>
                <p>{{ 'warning_continue'|trans }}</p>
            </div>
            <div class="flex justify-center items-center gap-2">
                <a href="{{ path(route ~ '_delete', app.current_route_parameters|merge({ confirmed: 1 })) }}" class="btn btn-primary luxury-light square">
                    {{ 'confirm'|trans }}
                </a>
                <a href="{{ path(route ~ '_list') }}" class="btn btn-link">
                    {{ 'cancel'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
