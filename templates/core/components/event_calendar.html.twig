<div {{ attributes }}>
    <div class="card">
        <div class="card-title items-center justify-between luxury">
            <div>Weekly Events Planner</div>
            {% if this.canEdit %}
                <button
                        type="button"
                        class="btn-icon btn-link {{ this.editorMode ? 'active' }}"
                        title="{{ this.editorMode ? 'Exit editor mode' : 'Editor mode' }}"
                        data-action="live#action"
                        data-live-action-param="toggleEditor"
                >
                    <i class="ph ph-pencil-simple-line"></i>
                </button>
            {% endif %}
        </div>
        <div class="card-body">
            <div class="flex items-center justify-center gap-2 mb-2">
                <button type="button" class="btn-icon btn-link" title="Previous week"
                        data-action="live#action" data-live-action-param="changeWeek" data-live-direction-param="-1">
                    <i class="ph ph-caret-left"></i>
                </button>
                <div>{{ this.weekStart|date('j F') }} - {{ this.weekEnd|date('j F') }}</div>
                <button type="button" class="btn-icon btn-link" title="Next week"
                        data-action="live#action" data-live-action-param="changeWeek" data-live-direction-param="1">
                    <i class="ph ph-caret-right"></i>
                </button>
            </div>
            <div class="week">
                {% for day in this.days %}
                    {% set dayKey = day.date|date('Y-m-d') %}
                    <div class="day">
                        <div class="flex justify-start gap-2 items-center mb-2">
                            <p class="day__name text-small">{{ day.date|date('D')|upper }}</p>
                            <p class="day__date text-bold">{{ day.date|date('j') }}</p>
                            {% if this.editorMode %}
                                <button type="button" class="btn-icon btn-link" title="Add event"
                                        data-action="live#action"
                                        data-live-action-param="openCreate"
                                        data-live-day-param="{{ dayKey }}">
                                    <i class="ph ph-plus"></i>
                                </button>
                            {% endif %}
                        </div>
                        {% for event in day.events %}
                            {% include '@CitadelAureum/core/events/blocks/event.html.twig' with { event } %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if this.createDay or this.editEventId %}
        <div class="modal-overlay" role="dialog" aria-modal="true" aria-label="{{ this.editEventId ? 'Edit event' : 'New event' }}">
            <div class="card modal-overlay__card">
                <div class="card-title luxury items-center justify-between">
                    {% if this.editEventId %}
                        Edit Event - {{ this.editEvent.name }}
                    {% else %}
                        New Event - {{ this.createDay|date('l j F') }}
                    {% endif %}
                    <button type="button" class="btn-icon btn-link" title="Close"
                            data-action="live#action" data-live-action-param="closeModal">
                        <i class="ph ph-x"></i>
                    </button>
                </div>
                <div class="card-body">
                    {{ form_start(form, { attr: { 'data-action': 'live#action:prevent', 'data-live-action-param': 'save' } }) }}
                    <div class="flex gap-2 mb-2">
                        {{ form_row(form.name) }}
                        {{ form_row(form.type) }}
                        {{ form_row(form.start) }}
                        {{ form_row(form.end) }}
                    </div>
                    <div class="mb-2">
                        {{ form_row(form.description) }}
                        {{ form_row(form.link) }}
                        {{ form_row(form.restaurant) }}
                    </div>
                    <div class="flex gap-2 justify-end">
                        <button type="submit" class="luxury-light square btn btn-primary">
                            {{ this.editEventId ? 'Save changes' : 'Add event' }}
                        </button>
                        {% if this.editEventId %}
                            <button type="button" class="btn btn-outlined"
                                    data-action="live#action"
                                    data-live-action-param="delete"
                                    data-live-confirm-param="Delete this event? This cannot be undone.">
                                <i class="ph ph-trash"></i> Delete
                            </button>
                        {% endif %}
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    {% endif %}
</div>