<div {{ attributes.defaults({ 'class': 'stock-take' }) }}>
    {% if this.saved %}
        <div class="alert-success mb-4"><p>Stock take saved.</p></div>
    {% elseif this.nothingToSave %}
        <div class="alert-warning mb-4"><p>Nothing to save — enter a count before saving.</p></div>
    {% endif %}

    <div class="card">
        <div class="card-title luxury">Count stock</div>
        <div class="card-body">
            <p class="text-small">Enter what is on the shelf. Packs and loose units combine as you type, and a count of zero is a real observation.</p>

            <div class="flex gap-2 items-center mb-4">
                <select data-model="locationId">
                    <option value="">All locations</option>
                    {% for location in this.locations %}
                        <option value="{{ location.id }}" {% if this.locationId == location.id %}selected{% endif %}>{{ location.name }}</option>
                    {% endfor %}
                </select>
                <span class="text-small">{{ this.enteredCount }} item{{ this.enteredCount == 1 ? '' : 's' }} entered</span>
            </div>

            <table class="text-left">
                <tr>
                    <th>Item</th>
                    <th>Location</th>
                    <th>On hand</th>
                    <th>Packs</th>
                    <th>Loose</th>
                    <th>Counted</th>
                </tr>
                {% for row in this.rows %}
                    <tr>
                        <td>{{ row.item.name }}</td>
                        <td>{{ row.item.location.name }}</td>
                        <td>{{ row.item.describeQuantity(row.onHand) }}</td>
                        <td>
                            {% if row.item.packSize %}
                                <input type="number" min="0" inputmode="numeric"
                                       data-model="entries[{{ row.item.id }}][packs]"
                                       value="{{ this.entries[row.item.id].packs|default('') }}"
                                       placeholder="{{ row.item.packLabel ?? 'pack' }}">
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>
                            <input type="number" min="0" inputmode="numeric"
                                   data-model="entries[{{ row.item.id }}][loose]"
                                   value="{{ this.entries[row.item.id].loose|default('') }}"
                                   placeholder="{{ row.item.unit }}">
                        </td>
                        <td>
                            {{ row.item.describeQuantity(row.entered) }}
                            {% if row.rising %}
                                <div class="alert-warning mt-2">
                                    <p class="text-small">Higher than stock on hand — record the delivery, or re-check the shelf.</p>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-small">No items to count here.</td>
                    </tr>
                {% endfor %}
            </table>

            <div class="mt-4 flex flex-col gap-2">
                <textarea data-model="notes" rows="2" placeholder="Notes (optional)">{{ this.notes }}</textarea>
                <div>
                    <button type="button" class="btn btn-primary" data-action="live#action" data-live-action-param="save">
                        <i class="ph ph-check"></i> Save stock take
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
