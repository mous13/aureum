{% extends '@CitadelAureum/core/base.html.twig' %}
{% block title_page %}Choose a password{% endblock %}
{% block body %}
    <div class="card">
        <div class="card-title luxury">Choose your password</div>
        <div class="card-body">
            <p class="text-small mb-4">
                Welcome, {{ employee.name }}. Your account was set up with a temporary password.
                Choose your own now &mdash; nobody else should know it, including whoever created your account.
            </p>
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="flex justify-end mt-4">
                <button type="submit" class="btn btn-primary luxury-light square">Set password</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
