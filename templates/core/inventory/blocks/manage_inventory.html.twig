<div class="card">
    <div class="card-title luxury">Add new inventory</div>
    <div class="card-body">
        {{form_start(inventoryForm) }}
            {{ form_row(inventoryForm.name) }}
            {{ form_row(inventoryForm.position) }}
            {{ form_row(inventoryForm.active) }}
            <button type="submit" class="btn btn-primary">Add inventory</button>
        {{ form_end(inventoryForm) }}
    </div>
</div>
<div class="card mt-5">
    <div class="card-title luxury">Inventories</div>
    <div class="card-body">
        <table class="text-left">
            <tr>
                <th>Name</th>
                <th>Positions</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
            {% for inventory in inventories %}
                <tr>
                    <td>{{ inventory.name }}</td>
                    <td>{{ inventory.position }}</td>
                    <td>{{ inventory.active ? 'Yes' : 'No' }}</td>
                    <td>
                        {% embed '@Forumify/components/modal.html.twig' %}
                            {% block modalOpenButton %}
                        <button type="button" class="btn-link btn-icon" {{ stimulus_action('forumify/forumify-platform/modal', 'open') }}>
                            <i class="ph ph-pencil"></i>
                        </button>
                            {% endblock %}
                            {% block modalContent %}
                                <div class="card">
                                    <div class="card-title luxury">Edit {{ inventory.name }}</div>
                                    <div class="card-body">
                                        <p>Edit</p>
                                            {{ form_start(inventoryEditForms[inventory.id]) }}
                                            <input type="hidden" name="inventory_id" value="{{ inventory.id }}">
                                                {{ form_row(inventoryEditForms[inventory.id].name) }}
                                                {{ form_row(inventoryEditForms[inventory.id].position) }}
                                                {{ form_row(inventoryEditForms[inventory.id].active) }}
                                                <button type="submit" class="btn btn-primary">Save</button>
                                            {{ form_end(inventoryEditForms[inventory.id]) }}
                                    </div>
                                </div>
                            {% endblock %}
                        {% endembed %}
                    </td>
                </tr>
            {% endfor %}
        </table>
    </div>
</div>