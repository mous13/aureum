{% extends '@CitadelAureum/core/base.html.twig' %}

{% block title %}Manage Inventory{% endblock %}

{% block body %}
    {% embed '@Forumify/components/tabs.html.twig' %}
        {% block tabs %}
            <button type="button" class="luxury-light square btn-link" data-tab-id="manage-inventory">Manage Inventory</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="categories">Categories</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="storage-locations">Storage Locations</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="items">Items</button>
        {% endblock %}
        {% block tabpanels %}
            <div id="manage-inventory">
                {% include '@CitadelAureum/core/inventory/blocks/manage_inventory.html.twig' %}
            </div>
            <div id="categories">
                {% include '@CitadelAureum/core/inventory/blocks/categories.html.twig' %}
            </div>
            <div id="storage-locations">
                {% include '@CitadelAureum/core/inventory/blocks/storage_locations.html.twig' %}
            </div>
            <div id="items">
                {% include '@CitadelAureum/core/inventory/blocks/items.html.twig' %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
