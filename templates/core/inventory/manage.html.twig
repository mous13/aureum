{% extends '@CitadelAureum/core/base.html.twig' %}

{% block title %}Manage Inventory{% endblock %}

{% block body %}
    <style>
        .inv-manage { display: flex; flex-direction: column; gap: 2rem; }
        .inv-panel { border: 1px solid rgba(0, 0, 0, 0.12); border-radius: 10px; padding: 1rem 1.1rem; }
        .inv-panel h2 { margin: 0 0 0.75rem; font-size: 1.05rem; }
        .inv-table { width: 100%; border-collapse: collapse; }
        .inv-table th, .inv-table td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid rgba(0, 0, 0, 0.08); }
        .inv-tag { font-size: 0.75rem; padding: 0.1rem 0.45rem; border-radius: 999px; border: 1px solid rgba(0, 0, 0, 0.2); }
        .inv-tag-warn { font-size: 0.75rem; font-weight: 600; padding: 0.1rem 0.45rem; border-radius: 999px; border: 1px solid #d33; color: #d33; background: rgba(221, 51, 51, 0.08); }
        .inv-form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem; align-items: end; }
    </style>

    <div class="mb-4 flex flex-wrap items-center justify-between">
        <h1 class="mb-0">Manage Inventory</h1>
        <a class="btn btn-link" href="{{ path('aureum_inventory') }}">Back to Inventory</a>
    </div>

    <div class="inv-manage">
        <section class="inv-panel">
            <h2>Inventories</h2>
            <p class="text-small">Each inventory is a countable list, like General Stock or Housekeeping.</p>

            <table class="inv-table">
                <thead>
                    <tr><th>Name</th><th>Position</th><th>Active</th></tr>
                </thead>
                <tbody>
                    {% for inventory in inventories %}
                        <tr>
                            <td>{{ inventory.name }}</td>
                            <td>{{ inventory.position }}</td>
                            <td>{{ inventory.active ? 'Yes' : 'No' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="text-small">No inventories yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {{ form_start(inventoryForm) }}
                <div class="inv-form-row mt-4">
                    {{ form_row(inventoryForm.name) }}
                    {{ form_row(inventoryForm.position) }}
                    {{ form_row(inventoryForm.active) }}
                    <button type="submit" class="btn btn-primary">Add inventory</button>
                </div>
            {{ form_end(inventoryForm) }}
        </section>

        <section class="inv-panel">
            <h2>Categories</h2>
            <p class="text-small">Categories group items within an inventory, like Essentials or Cleaning Supplies.</p>

            <table class="inv-table">
                <thead>
                    <tr><th>Inventory</th><th>Name</th><th>Position</th></tr>
                </thead>
                <tbody>
                    {% for inventory in inventories %}
                        {% for category in inventory.categories %}
                            <tr>
                                <td>{{ inventory.name }}</td>
                                <td>{{ category.name }}</td>
                                <td>{{ category.position }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="3" class="text-small">No categories yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {{ form_start(categoryForm) }}
                <div class="inv-form-row mt-4">
                    {{ form_row(categoryForm.inventory) }}
                    {{ form_row(categoryForm.name) }}
                    {{ form_row(categoryForm.position) }}
                    <button type="submit" class="btn btn-primary">Add category</button>
                </div>
            {{ form_end(categoryForm) }}
        </section>

        <section class="inv-panel">
            <h2>Storage locations</h2>
            <p class="text-small">Bulk stores are counted and drive the reorder forecast. Working locations — an office shelf, the corner shop — are destinations and are never forecast.</p>

            <table class="inv-table">
                <thead>
                    <tr><th>Name</th><th>Type</th><th>Position</th></tr>
                </thead>
                <tbody>
                    {% for location in locations %}
                        <tr>
                            <td>{{ location.name }}</td>
                            <td><span class="inv-tag">{{ location.type.label }}</span></td>
                            <td>{{ location.position }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3" class="text-small">No storage locations yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {{ form_start(locationForm) }}
                <div class="inv-form-row mt-4">
                    {{ form_row(locationForm.name) }}
                    {{ form_row(locationForm.type) }}
                    {{ form_row(locationForm.position) }}
                    {{ form_row(locationForm.active) }}
                    <button type="submit" class="btn btn-primary">Add location</button>
                </div>
            {{ form_end(locationForm) }}
        </section>

        <section class="inv-panel">
            <h2>Items</h2>
            <p class="text-small">Every item needs a lead time before it can be forecast. An item with no lead time set will never appear on the reorder screen.</p>

            <table class="inv-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Name</th>
                        <th>Unit</th>
                        <th>Pack size</th>
                        <th>Lead time</th>
                        <th>Buffer</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        {% for item in category.items %}
                            <tr>
                                <td>{{ category.name }}</td>
                                <td>{{ item.name }}</td>
                                <td>{{ item.unit }}</td>
                                <td>{{ item.packSize ?? '-' }}{{ item.packLabel ? ' ' ~ item.packLabel : '' }}</td>
                                <td>
                                    {% if item.leadTimeDays is null %}
                                        <span class="inv-tag-warn">Not set</span>
                                    {% else %}
                                        {{ item.leadTimeDays }} day{{ item.leadTimeDays == 1 ? '' : 's' }}
                                    {% endif %}
                                </td>
                                <td>{{ item.safetyBufferDays }} day{{ item.safetyBufferDays == 1 ? '' : 's' }}</td>
                                <td>{{ item.location.name }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="7" class="text-small">No items yet.</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            {{ form_start(itemForm) }}
                <div class="inv-form-row mt-4">
                    {{ form_row(itemForm.category) }}
                    {{ form_row(itemForm.location) }}
                    {{ form_row(itemForm.name) }}
                    {{ form_row(itemForm.unit) }}
                    {{ form_row(itemForm.packSize) }}
                    {{ form_row(itemForm.packLabel) }}
                    {{ form_row(itemForm.leadTimeDays) }}
                    {{ form_row(itemForm.safetyBufferDays) }}
                    {{ form_row(itemForm.active) }}
                    <button type="submit" class="btn btn-primary">Add item</button>
                </div>
            {{ form_end(itemForm) }}
        </section>
    </div>
{% endblock %}
