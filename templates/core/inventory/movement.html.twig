{% extends '@CitadelAureum/core/base.html.twig' %}

{% block title %}Record Movement{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between">
        <h1 class="mb-0">Record Movement</h1>
        <a class="btn btn-link" href="{{ path('aureum_inventory') }}">Back to Inventory</a>
    </div>

    <div class="card">
        <div class="card-title luxury">Record a movement</div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.item) }}
                {{ form_row(form.reason) }}
                {{ form_row(form.direction) }}
                {{ form_row(form.quantity) }}
                {{ form_row(form.destination) }}
                {{ form_row(form.occurredAt) }}
                {{ form_row(form.notes) }}
                <button type="submit" class="btn btn-primary">Record</button>
            {{ form_end(form) }}
        </div>
    </div>
    <div class="card mt-5">
        <div class="card-title luxury">Recent movements</div>
        <div class="card-body">
            <p class="text-small">Deliveries are the only thing that adds stock. A delivery that is never recorded reads as an unexplained rise on the next count.</p>
            <table class="text-left">
                <tr>
                    <th>When</th>
                    <th>Item</th>
                    <th>Direction</th>
                    <th>Reason</th>
                    <th>Quantity</th>
                    <th>Destination</th>
                    <th>Recorded by</th>
                </tr>
                {% for movement in movements %}
                    <tr>
                        <td>{{ movement.occurredAt|date('j M Y, H:i') }}</td>
                        <td>{{ movement.item.name }}</td>
                        <td>{{ movement.direction.label }}</td>
                        <td>{{ movement.reason.label }}</td>
                        <td>{{ movement.item.describeQuantity(movement.quantity) }}</td>
                        <td>{{ movement.destination ? movement.destination.name : '-' }}</td>
                        <td>{{ movement.recordedBy.name }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-small">No movements recorded yet.</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
