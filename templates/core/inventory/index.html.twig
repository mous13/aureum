{% extends '@CitadelAureum/core/base.html.twig' %}

{% block title %}Inventory{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between">
        <h1 class="mb-0">Inventory</h1>
        <a class="btn btn-link" href="{{ path('aureum_inventory_reorder') }}">
            <i class="ph ph-shopping-cart"></i> Reorder
        </a>
    </div>

    {% for row in rows %}
        <div class="card{{ loop.first ? '' : ' mt-5' }}">
            <div class="card-title luxury">{{ row.inventory.name }}</div>
            <div class="card-body">
                <table class="text-left">
                    <tr>
                        <th>Items</th>
                        <th>Last counted</th>
                        <th>Counted by</th>
                    </tr>
                    <tr>
                        <td>{{ row.itemCount }}</td>
                        <td>{{ row.lastCountedAt ? row.lastCountedAt|date('j M Y, H:i') : 'Never' }}</td>
                        <td>{{ row.lastCountedBy ? row.lastCountedBy.name : '-' }}</td>
                    </tr>
                </table>
                {% if is_granted('aureum.module.inventory.count') %}
                    <div class="mt-4">
                        <a class="btn btn-primary" href="{{ path('aureum_inventory_take', { id: row.inventory.id }) }}">
                            <i class="ph ph-clipboard-text"></i> Stock take
                        </a>
                        <a class="btn btn-link" href="{{ path('aureum_inventory_movements') }}">
                            <i class="ph ph-arrows-left-right"></i> Record Movement
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="card">
            <div class="card-title luxury">Inventories</div>
            <div class="card-body">
                <p>No inventories yet.</p>
                <p class="text-small">Create one from Manage Inventory, or run the seed command to load General Stock.</p>
            </div>
        </div>
    {% endfor %}
{% endblock %}
