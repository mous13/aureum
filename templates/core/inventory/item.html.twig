{% extends '@CitadelAureum/core/base.html.twig' %}

{% block title %}{{ item.name }}{% endblock %}

{% block body %}
    <div class="mb-4 flex flex-wrap items-center justify-between">
        <h1 class="mb-0">{{ item.name }}</h1>
        <a class="btn btn-link" href="{{ path('aureum_inventory') }}">Back to Inventory</a>
    </div>

    <div class="card">
        <div class="card-title luxury">Settings</div>
        <div class="card-body">
            <table class="text-left">
                <tr>
                    <th>Category</th>
                    <td>{{ item.category.name }}</td>
                </tr>
                <tr>
                    <th>Location</th>
                    <td>{{ item.location.name }}</td>
                </tr>
                <tr>
                    <th>Unit</th>
                    <td>{{ item.unit }}</td>
                </tr>
                <tr>
                    <th>Pack size</th>
                    <td>{{ item.packSize ?? '-' }}{{ item.packLabel ? ' ' ~ item.packLabel : '' }}</td>
                </tr>
                <tr>
                    <th>Lead time</th>
                    <td>{{ item.leadTimeDays is null ? 'Not set' : item.leadTimeDays ~ ' day' ~ (item.leadTimeDays == 1 ? '' : 's') }}</td>
                </tr>
                <tr>
                    <th>Safety buffer</th>
                    <td>{{ item.safetyBufferDays }} day{{ item.safetyBufferDays == 1 ? '' : 's' }}</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="card mt-5">
        <div class="card-title luxury">Current forecast</div>
        <div class="card-body">
            <table class="text-left">
                <tr>
                    <th>Status</th>
                    <td>
                        {{ forecast.status.label }}
                        {% if forecast.provisional %}
                            <span class="tag">Provisional</span>
                        {% endif %}
                        {% if forecast.needsReview %}
                            <span class="tag">Needs review</span>
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Stock on hand</th>
                    <td>{{ forecast.status.value == 'no_data' ? 'Unknown' : item.describeQuantity(forecast.stockOnHand) }}</td>
                </tr>
                <tr>
                    <th>Consumption rate</th>
                    <td>{{ forecast.ratePerDay is not null ? forecast.ratePerDay|round(2) ~ ' ' ~ item.unit ~ '/day' : '-' }}</td>
                </tr>
                <tr>
                    <th>Days of cover</th>
                    <td>{{ forecast.daysOfCover is not null ? forecast.daysOfCover|round(1) ~ ' days' : '-' }}</td>
                </tr>
                <tr>
                    <th>Order by</th>
                    <td>{{ forecast.orderBy is not null ? forecast.orderBy|date('j M Y') : '-' }}</td>
                </tr>
                <tr>
                    <th>Order</th>
                    <td>
                        {% if forecast.orderPacks is not null %}
                            {{ forecast.orderPacks }} {{ item.packLabel ?? 'pack' }}{{ forecast.orderPacks == 1 ? '' : 's' }}
                        {% elseif forecast.orderQuantity is not null %}
                            {{ forecast.orderQuantity }} {{ item.unit }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                </tr>
                <tr>
                    <th>Based on</th>
                    <td>{{ forecast.usableIntervals }} usable interval{{ forecast.usableIntervals == 1 ? '' : 's' }}, {{ forecast.observedDays|round(1) }} observed days</td>
                </tr>
            </table>
        </div>
    </div>
    <div class="card mt-5">
        <div class="card-title luxury">Counts</div>
        <div class="card-body">
            <table class="text-left">
                <tr>
                    <th>Date</th>
                    <th>Quantity</th>
                    <th>Counted by</th>
                </tr>
                {% for line in counts %}
                    <tr>
                        <td>{{ line.stockCount.countedAt|date('j M Y, H:i') }}</td>
                        <td>{{ item.describeQuantity(line.quantity) }}</td>
                        <td>{{ line.stockCount.countedBy.name }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-small">No counts in this window.</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
    <div class="card mt-5">
        <div class="card-title luxury">Movements</div>
        <div class="card-body">
            <table class="text-left">
                <tr>
                    <th>Date</th>
                    <th>Direction</th>
                    <th>Reason</th>
                    <th>Quantity</th>
                    <th>Destination</th>
                </tr>
                {% for movement in movements %}
                    <tr>
                        <td>{{ movement.occurredAt|date('j M Y, H:i') }}</td>
                        <td>{{ movement.direction.label }}</td>
                        <td>{{ movement.reason.label }}</td>
                        <td>{{ item.describeQuantity(movement.quantity) }}</td>
                        <td>{{ movement.destination ? movement.destination.name : '-' }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-small">No movements in this window.</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
    <div class="card mt-5">
        <div class="card-title luxury">Catalogue changes</div>
        <div class="card-body">
            <table class="text-left">
                <tr>
                    <th>When</th>
                    <th>Who</th>
                    <th>What changed</th>
                </tr>
                {% for log in logs %}
                    <tr>
                        <td>{{ log.createdAt|date('j M Y, H:i') }}</td>
                        <td>{{ log.performedBy.name }}</td>
                        <td>
                            {{ log.action.label }}
                            {% for field, change in log.changes %}
                                {% set isPair = change is iterable and change.old is defined and change.new is defined %}
                                <div class="text-small">
                                    {{ field }}:
                                    {% if isPair %}
                                        {{ change.old is same as(false) ? 'No' : (change.old is same as(true) ? 'Yes' : (change.old ?? '-')) }}
                                        &rarr;
                                        {{ change.new is same as(false) ? 'No' : (change.new is same as(true) ? 'Yes' : (change.new ?? '-')) }}
                                    {% else %}
                                        {{ change is same as(false) ? 'No' : (change is same as(true) ? 'Yes' : (change ?? '-')) }}
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-small">No catalogue changes recorded.</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
