{% extends '@CitadelAureum/core/base.html.twig' %}
{% block body %}
    {{ component('Aureum\\Announcements', { module: 'bookings' }) }}

    <div class="au-page-head">
        <h1 class="au-page-title">Bookings</h1>
        {% if is_granted('aureum.module.bookings.manage') %}
            <div class="au-page-actions">
                {% embed '@CitadelAureum/core/components/drawer.html.twig' with {
                    drawer_id: 'booking-new',
                    drawer_open: form.vars.submitted and not form.vars.valid,
                    drawer_autofocus: true,
                    drawer_wide: true,
                } %}
                    {% block drawer_trigger %}
                        <button type="button" class="luxury-light square btn btn-primary" data-action="drawer#open">
                            <i class="ph ph-plus"></i>New Booking
                        </button>
                    {% endblock %}
                    {% block drawer_title %}New Booking{% endblock %}
                    {% block drawer_body %}
                        {{ form_start(form, { attr: { id: 'booking-new-form' } }) }}
                        <div class="form-split-body" data-controller="booking-form" data-type-meta="{{ typeMeta|json_encode|e('html_attr') }}">
                            <div class="form-split">
                                <div class="form-rail luxury">
                                    <div class="form-rail-inner">
                                        <div>
                                            <span class="form-label">{{ form.type.vars.label }}</span>
                                            <div class="type-toggle" role="radiogroup" aria-label="Booking type">
                                                {% for radio in form.type %}
                                                    <label class="type-toggle-item" for="{{ radio.vars.id }}">
                                                        {{ form_widget(radio) }}
                                                        <i class="{{ typeMeta[radio.vars.value].icon }}"></i>
                                                        <span>{{ radio.vars.label }}</span>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                        </div>
                                        {{ form_row(form.date) }}
                                        {{ form_row(form.status) }}
                                        {{ form_row(form.reference) }}
                                    </div>
                                </div>

                                <div class="form-detail-panel">
                                    <div class="form-detail-head">
                                        <i class="icon" data-booking-form-target="serviceIcon"></i>
                                        <h2 data-booking-form-target="serviceHeading">Booking Details</h2>
                                    </div>
                                    {% include '@CitadelAureum/core/bookings/blocks/details_fields.html.twig' with {
                                        'details': form.details,
                                        'showLabels': true,
                                        'layout': 'grid'
                                    } %}

                                    <div class="form-section">
                                        <span class="form-label">Guest</span>
                                        <div class="form-field-grid">
                                            {{ form_row(form.guest) }}
                                            {{ form_row(form.number) }}
                                            {{ form_row(form.email) }}
                                        </div>
                                    </div>

                                    <div class="form-section">
                                        <span class="form-label">Supplier</span>
                                        <div class="form-field-grid">
                                            {{ form_row(form.middleman) }}
                                            {{ form_row(form.vendor) }}
                                            {{ form_row(form.cost) }}
                                        </div>
                                    </div>

                                    <div class="form-section">
                                        {{ form_row(form.notes) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{ form_end(form) }}
                    {% endblock %}
                    {% block drawer_footer %}
                        <button type="button" class="btn-outlined square" data-action="drawer#close">Cancel</button>
                        <button type="submit" form="booking-new-form" class="luxury-light square btn btn-primary">Submit Booking</button>
                    {% endblock %}
                {% endembed %}
            </div>
        {% endif %}
    </div>

    {% embed '@Forumify/components/tabs.html.twig' %}
        {% block tabs %}
            <button type="button" class="luxury-light square btn-link" data-tab-id="not_completed">Not Completed</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="completed">Completed</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="cancelled">Cancelled</button>
            <button type="button" class="luxury-light square btn-link btn-icon" data-tab-id="help">Help</button>
        {% endblock %}
        {% block tabpanels %}
            <div id="not_completed" class="card w-100">
                <div class="card-title" style="background-color:#13233A;color:#ececec;">Scheduled Bookings</div>
                <div class="card-body">
                    {{ component('Aureum\\BookingTable', {
                        hotelId: hotelId,
                        statuses: ['unconfirmed', 'confirmed']
                    }) }}
                </div>
            </div>
            <div id="completed" class="card w-100">
                <div class="card-title" style="background-color:#13233A;color:#ececec;">Completed Bookings</div>
                <div class="card-body">
                    {{ component('Aureum\\BookingTable', {
                        hotelId: hotelId,
                        statuses: ['completed']
                    }) }}
                </div>
            </div>
            <div id="cancelled" class="card w-100">
                <div class="card-title" style="background-color:#13233A;color:#ececec;">Cancelled Bookings</div>
                <div class="card-body">
                    {{ component('Aureum\\BookingTable', {
                        hotelId: hotelId,
                        statuses: ['cancelled']
                    }) }}
                </div>
            </div>
            <div id="help" class="w-100">
                {% include '@CitadelAureum/core/bookings/blocks/help.html.twig' with {
                    'types': types
                } %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
