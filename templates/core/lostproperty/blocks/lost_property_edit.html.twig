{% set form_id = editForm.vars.id ~ '-form' %}
{% embed '@CitadelAureum/core/components/drawer.html.twig' with { drawer_id: editForm.vars.id ~ '-drawer' } %}
    {% block drawer_trigger %}
        <button type="button" class="btn-link btn-icon" aria-label="Edit entry" data-action="drawer#open">
            <i class="ph ph-pencil-simple-line" style="color:#1a3f5f;"></i>
        </button>
    {% endblock %}
    {% block drawer_title %}Edit Property: {{ property.description }}{% endblock %}
    {% block drawer_body %}
        {{ form_start(editForm, { attr: { id: form_id } }) }}
        <div class="form-split-body">
            <div class="form-split">
                <div class="form-rail luxury">
                    <div class="form-rail-inner">
                        <div>
                            <span class="form-label">{{ editForm.type.vars.label }}</span>
                            <div class="type-toggle" role="radiogroup" aria-label="Property type">
                                {% for radio in editForm.type %}
                                    <label class="type-toggle-item" for="{{ radio.vars.id }}">
                                        {{ form_widget(radio) }}
                                        <i class="{{ radio.vars.value == 'lost' ? 'ph ph-map-pin-line' : 'ph ph-check-circle' }}"></i>
                                        <span>{{ radio.vars.label }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                        {{ form_row(editForm.status) }}
                    </div>
                </div>

                <div class="form-detail-panel">
                    <div class="form-detail-head">
                        <i class="icon ph ph-suitcase-simple"></i>
                        <h2>Property Details</h2>
                    </div>

                    <div>
                        <span class="form-label">Property Information</span>
                        <div class="form-field-grid">
                            {{ form_row(editForm.location) }}
                            {{ form_row(editForm.storedLocation) }}
                            {{ form_row(editForm.reportedBy) }}
                        </div>
                        <div class="mt-2">
                            {{ form_row(editForm.description) }}
                        </div>
                    </div>

                    <div class="form-section">
                        <span class="form-label">Guest</span>
                        <div class="form-field-grid">
                            {{ form_row(editForm.guest) }}
                            {{ form_row(editForm.contact) }}
                        </div>
                    </div>

                    <div class="form-section">
                        {{ form_row(editForm.note) }}
                    </div>
                </div>
            </div>
        </div>
        {{ form_end(editForm) }}
        {% if is_granted('aureum.module.lost_property.manage') %}
            <form
                id="{{ form_id }}-delete"
                method="post"
                action="{{ path('aureum_lost_property_delete', {id: property.id}) }}"
                onsubmit="return confirm('Permanently delete this record and its history? This cannot be undone.');"
            >
                <input type="hidden" name="_token" value="{{ csrf_token('aureum_lost_property_delete_' ~ property.id) }}">
            </form>
        {% endif %}
    {% endblock %}
    {% block drawer_footer %}
        {% if is_granted('aureum.module.lost_property.manage') %}
            <button type="submit" form="{{ form_id }}-delete" class="btn-link btn-small text-error au-drawer-foot-start">Delete record</button>
        {% endif %}
        <button type="button" class="btn-outlined square" data-action="drawer#close">Cancel</button>
        <button type="submit" form="{{ form_id }}" class="luxury-light square btn btn-primary">Save Changes</button>
    {% endblock %}
{% endembed %}
