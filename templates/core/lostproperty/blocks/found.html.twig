<div class="card-title" style="background-color:#13233A;color:#ececec;">
    Found Property
</div>
<div class="card-body">
    <table class="au-table-cards">
        <thead>
            <tr>
                <th class="text-left">Date</th>
                <th class="text-left">Guest Name</th>
                <th class="text-left">Guest Contact</th>
                <th class="text-left">Description</th>
                <th class="text-left">Found Location</th>
                <th class="text-left">Stored Location</th>
                <th class="text-left">Reported By</th>
                <th class="text-left">Status</th>
                <th class="text-left"></th>
            </tr>
        </thead>
        <tbody>
            {% for property in lostProperties %}
                {% set status = property.status.value %}
                {% if status in ['waiting for collection', 'waiting to be posted', 'stored']   %}
                    <tr>
                        <td data-label="Date">{{ property.createdAt|date('d/m/y H:i') }}</td>
                        <td data-label="Guest Name">{{ property.guest }}</td>
                        <td data-label="Guest Contact">{{ property.contact }}</td>
                        <td data-label="Description">{{ property.description }}</td>
                        <td data-label="Found Location">{{ property.location }}</td>
                        <td data-label="Stored Location">{{ property.storedLocation }}</td>
                        <td data-label="Reported By">{{ property.reportedBy.name }}</td>
                        <td data-label="Status">{{ property.status.value }}</td>
                        <td>
                            <div class="flex">
                                {% include '@CitadelAureum/core/lostproperty/blocks/lost_property_notes.html.twig' with {
                                    'property': property,
                                    'logs': propertyLogs[property.id] ?? []
                                } %}
                                {% include '@CitadelAureum/core/lostproperty/blocks/lost_property_edit.html.twig' with {
                                    'property': property,
                                    'editForm': editForms[property.id]
                                } %}
                            </div>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>