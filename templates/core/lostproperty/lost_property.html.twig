{% extends '@CitadelAureum/core/base.html.twig' %}
{% block body %}
    {{ component('Aureum\\Announcements', { module: 'lost_property' }) }}

    <div class="au-page-head">
        <h1 class="au-page-title">Lost Property</h1>
        {% if is_granted('aureum.module.lost_property.manage') %}
            <div class="au-page-actions">
                {% embed '@CitadelAureum/core/components/drawer.html.twig' with {
                    drawer_id: 'lost-property-new',
                    drawer_open: form.vars.submitted and not form.vars.valid,
                    drawer_autofocus: true,
                } %}
                    {% block drawer_trigger %}
                        <button type="button" class="luxury-light square btn btn-primary" data-action="drawer#open">
                            <i class="ph ph-plus"></i>New Entry
                        </button>
                    {% endblock %}
                    {% block drawer_title %}New Entry{% endblock %}
                    {% block drawer_body %}
                        {{ form_start(form, { attr: { id: 'lost-property-new-form' } }) }}
                        <div class="form-split-body">
                            <div class="form-split">
                                <div class="form-rail luxury">
                                    <div class="form-rail-inner">
                                        <div>
                                            <span class="form-label">{{ form.type.vars.label }}</span>
                                            <div class="type-toggle" role="radiogroup" aria-label="Property type">
                                                {% for radio in form.type %}
                                                    <label class="type-toggle-item" for="{{ radio.vars.id }}">
                                                        {{ form_widget(radio) }}
                                                        <i class="{{ radio.vars.value == 'lost' ? 'ph ph-map-pin-line' : 'ph ph-check-circle' }}"></i>
                                                        <span>{{ radio.vars.label }}</span>
                                                    </label>
                                                {% endfor %}
                                            </div>
                                        </div>
                                        {{ form_row(form.status) }}
                                    </div>
                                </div>

                                <div class="form-detail-panel">
                                    <div class="form-detail-head">
                                        <i class="icon ph ph-suitcase-simple"></i>
                                        <h2>Property Details</h2>
                                    </div>
                                    <div>
                                        <span class="form-label">Property Information</span>
                                        <div class="form-field-grid">
                                            {{ form_row(form.location) }}
                                            {{ form_row(form.storedLocation) }}
                                        </div>
                                        <div class="mt-2">
                                            {{ form_row(form.description) }}
                                        </div>
                                    </div>

                                    <div class="form-section">
                                        <span class="form-label">Guest</span>
                                        <div class="form-field-grid">
                                            {{ form_row(form.guest) }}
                                            {{ form_row(form.contact) }}
                                        </div>
                                    </div>

                                    <div class="form-section">
                                        {{ form_row(form.note) }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{ form_end(form) }}
                    {% endblock %}
                    {% block drawer_footer %}
                        <button type="button" class="btn-outlined square" data-action="drawer#close">Cancel</button>
                        <button type="submit" form="lost-property-new-form" class="luxury-light square btn btn-primary">Submit Entry</button>
                    {% endblock %}
                {% endembed %}
            </div>
        {% endif %}
    </div>

    {% embed '@Forumify/components/tabs.html.twig' %}
        {% block tabs %}
            <button type="button" class="luxury-light square btn-link" data-tab-id="lost">Lost Property</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="found">Found Property</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="closed">Closed Entries</button>
            <button type="button" class="luxury-light square btn-link btn-icon" data-tab-id="help">Help</button>
        {% endblock %}
        {% block tabpanels %}
            <div id="lost" class="card w-100">
                <div class="card-title" style="background-color:#13233A;color:#ececec;">Lost Property</div>
                <div class="card-body">
                    {{ component('Aureum\\LostPropertyTable', {
                        hotelId: hotelId,
                        statuses: ['open']
                    }) }}
                </div>
            </div>
            <div id="found" class="card w-100">
                <div class="card-title" style="background-color:#13233A;color:#ececec;">Found Property</div>
                <div class="card-body">
                    {{ component('Aureum\\LostPropertyTable', {
                        hotelId: hotelId,
                        statuses: ['waiting for collection', 'waiting to be posted', 'stored']
                    }) }}
                </div>
            </div>
            <div id="closed" class="card w-100">
                <div class="card-title" style="background-color:#13233A;color:#ececec;">Closed Entries</div>
                <div class="card-body">
                    {{ component('Aureum\\LostPropertyTable', {
                        hotelId: hotelId,
                        statuses: ['collected', 'posted', 'disposed']
                    }) }}
                </div>
            </div>
            <div id="help">
                {% include '@CitadelAureum/core/lostproperty/blocks/help.html.twig' %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
