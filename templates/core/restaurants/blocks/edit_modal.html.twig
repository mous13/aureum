{% embed '@Forumify/components/modal.html.twig' %}
    {% block modalOpenButton %}
        <button type="button" class="btn-link btn-icon btn-small" {{ stimulus_action('forumify/modal', 'open') }}>
            <i class="ph ph-pencil-simple-line" style="color:#1a3f5f;"></i>
        </button>
    {% endblock %}
    {% block modalContent %}
        <div class="card">
            <div class="card-title luxury">
                Edit Restaurant — {{ restaurant.name }}
            </div>
            <div class="card-body">
                {{ form_start(editForm) }}
                <div class="form-field-grid">
                    {{ form_row(editForm.name) }}
                    {{ form_row(editForm.neighbourhood) }}
                    {{ form_row(editForm.street) }}
                </div>
                <div class="form-field-grid">
                    {{ form_row(editForm.cuisines) }}
                    {{ form_row(editForm.mealPeriods) }}
                    {{ form_row(editForm.dietaryRequirements) }}
                    {{ form_row(editForm.tags) }}
                </div>
                <div class="form-section">
                    {{ form_row(editForm.connections) }}
                </div>
                <div class="flex justify-end mt-5">
                    <button type="submit" class="btn btn-primary luxury-light square">Save Changes</button>
                </div>
                {{ form_end(editForm) }}
            </div>
        </div>
    {% endblock %}
{% endembed %}