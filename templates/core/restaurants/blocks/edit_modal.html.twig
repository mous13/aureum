{% embed '@Forumify/components/modal.html.twig' %}
    {% block modalOpenButton %}
        <button type="button" class="btn-link btn-icon btn-small" {{ stimulus_action('forumify/modal', 'open') }}>
            <i class="ph ph-pencil-simple-line" style="color:#1a3f5f;"></i>
        </button>
    {% endblock %}
    {% block modalContent %}
        <div class="card">
            <div class="card-title" style="background-color:#13233A;color:#ececec;">
                Edit Restaurant — {{ restaurant.name }}
            </div>
            <div class="card-body">
                {{ form_start(editForm) }}
                <div class="flex gap-2 mb-2">
                    <div class="flex-grow">{{ form_widget(editForm.name) }}</div>
                    <div class="flex-grow">{{ form_widget(editForm.neighbourhood) }}</div>
                    <div class="flex-grow">{{ form_widget(editForm.street) }}</div>
                </div>
                <div class="flex gap-2 mb-2">
                    <div class="flex-grow">{{ form_widget(editForm.cuisines) }}</div>
                    <div class="flex-grow">{{ form_widget(editForm.mealPeriods) }}</div>
                    <div class="flex-grow">{{ form_widget(editForm.dietaryRequirements) }}</div>
                    <div class="flex-grow">{{ form_widget(editForm.tags) }}</div>
                </div>
                <div class="mb-2">
                    {{ form_widget(editForm.connections) }}
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="btn btn-primary luxury-light square">Save Changes</button>
                </div>
                {{ form_end(editForm) }}
            </div>
        </div>
    {% endblock %}
{% endembed %}