{% extends '@CitadelAureum/core/components/form.html.twig' %}
{% form_theme form _self %}

{% block _hotel_role_permissions_widget %}
    <style>
        .role-permissions {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
            gap: 0.75rem;
            margin-top: 0.5rem;
        }
        .role-permissions fieldset {
            border: 1px solid rgba(0, 0, 0, 0.12);
            border-radius: 8px;
            padding: 0.6rem 0.9rem 0.75rem;
            margin: 0;
        }
        .role-permissions legend {
            font-weight: 600;
            font-size: 0.9rem;
            padding: 0 0.3rem;
        }
        .role-permission-option {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.35rem;
            cursor: pointer;
        }
    </style>
    <div class="role-permissions">
        {% for moduleLabel, group in choices %}
            <fieldset>
                <legend>{{ moduleLabel }}</legend>
                {% for choice in group.choices %}
                    {% for child in form %}
                        {% if child.vars.value == choice.value %}
                            <label class="role-permission-option">
                                {{ form_widget(child) }}
                                <span>{{ choice.label }}</span>
                            </label>
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            </fieldset>
        {% endfor %}
    </div>
{% endblock %}
