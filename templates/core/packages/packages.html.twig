{% extends '@CitadelAureum/core/base.html.twig' %}
{% block body %}
    {{ component('Aureum\\Announcements', { module: 'packages' }) }}

    <div class="au-page-head">
        <h1 class="au-page-title">Packages</h1>
        <div class="au-page-actions">
            {% embed '@CitadelAureum/core/components/drawer.html.twig' with {
                drawer_id: 'package-new',
                drawer_open: form.vars.submitted and not form.vars.valid,
                drawer_autofocus: true,
            } %}
                {% block drawer_trigger %}
                    <button type="button" class="luxury-light square btn btn-primary" data-action="drawer#open">
                        <i class="ph ph-plus"></i>New Package
                    </button>
                {% endblock %}
                {% block drawer_title %}New Guest Package{% endblock %}
                {% block drawer_body %}
                    {{ form_start(form, { attr: { id: 'package-new-form' } }) }}
                    <div class="form-split-body">
                        <div class="form-split">
                            <div class="form-rail luxury">
                                <div class="form-rail-inner">
                                    {{ form_row(form.name) }}
                                </div>
                            </div>

                            <div class="form-detail-panel">
                                <div class="form-detail-head">
                                    <i class="icon ph ph-package"></i>
                                    <h2>Package Details</h2>
                                </div>

                                <div>
                                    <span class="form-label">Package Information</span>
                                    <div class="form-field-grid">
                                        {{ form_row(form.description) }}
                                        {{ form_row(form.location) }}
                                    </div>
                                </div>

                                <div class="form-section">
                                    {{ form_row(form.note) }}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{ form_end(form) }}
                {% endblock %}
                {% block drawer_footer %}
                    <button type="button" class="btn-outlined square" data-action="drawer#close">Cancel</button>
                    <button type="submit" form="package-new-form" class="luxury-light square btn btn-primary">Submit Package</button>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {% embed '@Forumify/components/tabs.html.twig' %}
        {% block tabs %}
            <button type="button" class="luxury-light square btn-link" data-tab-id="received">Received</button>
            <button type="button" class="luxury-light square btn-link" data-tab-id="collected">Picked Up</button>
            <button type="button" class="luxury-light square btn-link btn-icon" data-tab-id="help">Help</button>
        {% endblock %}
        {% block tabpanels %}
            <div id="received" class="card w-100">
                {% include '@CitadelAureum/core/packages/blocks/received.html.twig' with {
                    'packages': packages,
                    'logs': logs,
                    'editForms': editForms,
                } %}
            </div>
            <div id="collected" class="card w-100">
                {% include '@CitadelAureum/core/packages/blocks/collected.html.twig' with {
                    'packages': packages,
                    'logs': logs,
                    'editForms': editForms,
                } %}
            </div>
            <div id="help" class="w-100">
                {% include '@CitadelAureum/core/packages/blocks/help.html.twig' %}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
