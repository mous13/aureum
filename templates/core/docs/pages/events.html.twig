{% extends '@CitadelAureum/core/docs/layout.html.twig' %}

{% block article %}
    <p>
        Events is the what's-on calendar: music and nightlife, theatre, sports,
        food and drink, arts and culture, and family or seasonal happenings,
        both in the hotel and around town.
    </p>

    <h2>Common tasks</h2>
    <ol class="au-docs-steps">
        <li>Open <strong>Directory → Events</strong> to browse the calendar.</li>
        <li>Check upcoming events before a guest's stay so recommendations are ready.</li>
        <li>With manage permission, add events as soon as they're announced. The dashboard surfaces what's coming up.</li>
    </ol>
{% endblock %}
